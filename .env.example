# VolunteerHub - File cấu hình mẫu
# Sao chép file này thành .env và điền thông tin thực tế
# KHÔNG commit file .env lên GitHub

APP_NAME=VolunteerHub
APP_URL=http://localhost/VolunteerHub/public
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=volunteerhub
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=VH_SESSION
SESSION_LIFETIME=7200

# Bảo mật
SECRET_KEY=change_this_to_random_32_chars_string
CSRF_TOKEN_NAME=vh_csrf_token
